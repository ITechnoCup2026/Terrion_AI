# Terrion_AI — konfigurasi contoh.
#
#   cp .env.example .env
#
# Seluruh berkas ini boleh dibiarkan apa adanya kecuali AI_SERVICE_TOKEN.
# Layanan berjalan penuh, lulus seluruh uji, dan bisa didemokan tanpa satu pun
# kunci API — lihat LLM_PROVIDER di bawah.


# --- Autentikasi ------------------------------------------------------------

# Token yang wajib dibawa Terrion_Backend pada setiap permintaan /v1/*.
# Nilai apa pun boleh untuk pemakaian lokal, asal SAMA PERSIS dengan
# AI_SERVICE_TOKEN di sisi Go.
#
# Kosong berarti layanan menolak SEMUA permintaan, bukan menerima semuanya:
# layanan tanpa token yang dikonfigurasi tidak punya cara membedakan pemanggil
# yang sah. Untuk produksi: openssl rand -hex 32
AI_SERVICE_TOKEN=


# --- Lapis narasi -----------------------------------------------------------

# template | openrouter
#
# `template` adalah bawaan, dan itu disengaja: repo ini harus jalan, lulus uji,
# dan bisa didemokan tanpa akun penyedia mana pun. Kalimatnya dirakit dari
# fakta terhitung dengan f-string — tanpa jaringan, deterministik penuh.
#
# `openrouter` mengaktifkan model bahasa. Ia hanya dipakai kalau LLM_API_KEY
# juga terisi; tanpa itu layanan diam-diam kembali ke template.
LLM_PROVIDER=template

# Kunci OpenRouter (sk-or-v1-...). Biarkan kosong selama LLM_PROVIDER=template.
LLM_API_KEY=

# Endpoint yang berbicara skema OpenAI. Diganti hanya kalau pindah penyedia.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model utama, dan daftar cadangan yang dipakai OpenRouter sendiri kalau model
# pertama kehabisan kuota atau sedang tumbang. Berganti model adalah mengubah
# satu baris di sini, bukan menulis adaptor baru.
#
# ID di bawah diperiksa terhadap /api/v1/models: ada, gratis betulan
# (prompt=0, completion=0), dan mengumumkan dukungan "seed". Tiga ID
# sebelumnya (llama-3.3-70b, deepseek-chat-v3-0324, mistral-small-3.2-24b)
# sudah ditarik dari katalog, dan bentuk kegagalannya diam: setiap panggilan
# gagal, tercatat sebagai degraded, narasi jatuh ke templat, dan layanan tetap
# menjawab 200 dengan angka yang benar — jadi tidak ada yang terlihat rusak
# sementara penyedia LLM-nya tidak pernah bekerja sekali pun. Periksa ulang
# daftar ini sebelum menyalakan openrouter; katalog model gratis cepat berubah.
LLM_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_MODELS=z-ai/glm-5.2:free,minimax/minimax-m2.7:free

# Anggaran waktu narasi, milidetik. Jangan dinaikkan untuk mengejar model
# gratis yang lambat: anggaran ini melindungi permintaan pengguna, dan narasi
# yang tidak sempat datang digantikan templat tanpa ada angka yang berubah.
LLM_TIMEOUT_MS=2000


# --- Solver dan risiko ------------------------------------------------------

# Batas waktu CP-SAT per objektif, milidetik.
# BELUM DIBACA di Fase 1 — solver greedy tidak punya batas waktu. Nilainya
# mulai berlaku begitu app/solver/cpsat.py ada.
SOLVER_TIME_LIMIT_MS=1000

# Undian Monte Carlo untuk kuantil puncak mingguan yang dilaporkan.
# Pencarian di dalam solver memakai jumlah yang jauh lebih kecil dan tetap
# (app/solver/metrics.py SEARCH_DRAWS); angka ini hanya untuk metrik akhir.
# Menurunkannya membuat P50/P90 lebih berderau, bukan lebih cepat secara nyata.
MONTE_CARLO_DRAWS=2000


# --- Operasional ------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
# Log keluar sebagai JSON dengan request_id yang merambat dari sisi Go, jadi
# satu permintaan bisa ditelusuri lintas dua layanan dengan satu grep.
LOG_LEVEL=INFO
