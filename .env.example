# Terrion_AI — konfigurasi contoh.
#
#   cp .env.example .env
#
# Seluruh berkas ini boleh dibiarkan apa adanya kecuali AI_SERVICE_TOKEN.
# Layanan berjalan penuh, lulus seluruh uji, dan bisa didemokan tanpa satu pun
# kunci API — lihat LLM_PROVIDER di bawah.


# --- Autentikasi ------------------------------------------------------------

# Token yang wajib dibawa Terrion_Backend pada setiap permintaan /v1/*.
# Nilai apa pun boleh untuk pemakaian lokal, asal SAMA PERSIS dengan
# AI_SERVICE_TOKEN di sisi Go.
#
# Kosong berarti layanan menolak SEMUA permintaan, bukan menerima semuanya:
# layanan tanpa token yang dikonfigurasi tidak punya cara membedakan pemanggil
# yang sah. Untuk produksi: openssl rand -hex 32
AI_SERVICE_TOKEN=


# --- Lapis narasi -----------------------------------------------------------

# template | sumopod | openrouter
#
# `template` adalah bawaan, dan itu disengaja: repo ini harus jalan, lulus uji,
# dan bisa didemokan tanpa akun penyedia mana pun. Kalimatnya dirakit dari
# fakta terhitung dengan f-string — tanpa jaringan, deterministik penuh.
#
# `sumopod` dan `openrouter` mengaktifkan model bahasa. Keduanya hanya
# dipakai kalau LLM_API_KEY juga terisi; tanpa itu layanan diam-diam
# kembali ke template. `sumopod` mengirim payload OpenAI polos; hanya
# `openrouter` yang menambahkan parameter khasnya sendiri, karena
# penyedia lain menolaknya dengan 400.
LLM_PROVIDER=template

# Kunci penyedia. Biarkan kosong selama LLM_PROVIDER=template.
LLM_API_KEY=

# Endpoint yang berbicara skema OpenAI. Diganti bersamaan dengan
# LLM_PROVIDER: https://ai.sumopod.com/v1 untuk sumopod,
# https://openrouter.ai/api/v1 untuk openrouter.
LLM_BASE_URL=https://ai.sumopod.com/v1

# Model. Dipilih dengan diukur, bukan dari namanya. Delapan kandidat
# dijalankan dengan prompt yang sesungguhnya (latensi, biaya per propose
# yaitu tiga narasi, dan berapa yang lolos penjaga numerik):
#
#   gpt-5.4-nano            p50 1.774  p95 3.836   12/12 lolos   $0,00095
#   gpt-4.1-nano            p50 1.372  p95 6.078    8/12 lolos   $0,00033
#   gpt-4o-mini             p50 3.603  p95 7.162    6/6  lolos   $0,00044
#   gemini-3.5-flash-lite   p50 2.933  p95 9.372    6/6  lolos   $0,00159
#   deepseek-v4-flash       0/6 lolos, mentok max_tokens tiap kali
#   qwen3.8-flash           48 detik, mengabaikan max_tokens
#
# Yang memutuskan bukan kecepatan dan bukan biaya — pada volume ini keduanya
# tidak terasa — melainkan berapa narasi yang selamat dari penjaga.
# gpt-4.1-nano memang lebih murah dan p50-nya lebih cepat, tetapi gagal
# sepertiga: pada rencana "pasar" ia berulang kali menulis "13 minggu" untuk
# fakta yang berbunyi "9 minggu". Itu halusinasi sungguhan yang tertangkap,
# bukan penjaga yang terlalu galak. gpt-5.4-nano tidak pernah gagal sekali
# pun, dengan selisih biaya sekitar dua dolar per bulan pada 100 propose/hari.
#
# Sampelnya kecil (12 narasi per model, satu berkas fikstur). Ukur ulang
# dengan data sungguhan sebelum memperlakukan angka ini sebagai jaminan.
LLM_MODEL=gpt-5.4-nano

# HANYA dipakai oleh openrouter, yang punya routing cadangan sendiri di sisi
# server. Sumopod menolak field `models` dengan 400, dan mencoba ulang secara
# manual berarti membayar anggaran waktu dua kali — jadi kosong.
LLM_FALLBACK_MODELS=

# Anggaran waktu narasi, milidetik. Batas atasnya bukan selera: sisi Go
# menutup panggilan pada AI_SERVICE_TIMEOUT_MS=3500 per percobaan, dan
# solver plus Monte Carlo memakai ~50 ms sebelum narasi dimulai. 2.800
# menampung p95 gpt-4.1-nano (2.889 ms) nyaris seluruhnya sambil tetap
# muat di dalam anggaran Go. Ketiga narasi berjalan serentak, jadi ini
# anggaran untuk semuanya, bukan untuk satu. Naikkan hanya bersamaan
# dengan menaikkan angka di sisi Go.
LLM_TIMEOUT_MS=2800
# Anggaran token jawaban. Naik dari 220 karena permintaan kini menyertakan
# reasoning:{enabled:false} — tanpa itu model reasoning memakai seluruh
# anggaran untuk berpikir dan mengembalikan konten kosong.
LLM_MAX_TOKENS=400



# --- Solver dan risiko ------------------------------------------------------

# Batas waktu CP-SAT per objektif, milidetik.
# BELUM DIBACA di Fase 1 — solver greedy tidak punya batas waktu. Nilainya
# mulai berlaku begitu app/solver/cpsat.py ada.
SOLVER_TIME_LIMIT_MS=1000

# Undian Monte Carlo untuk kuantil puncak mingguan yang dilaporkan.
# Pencarian di dalam solver memakai jumlah yang jauh lebih kecil dan tetap
# (app/solver/metrics.py SEARCH_DRAWS); angka ini hanya untuk metrik akhir.
# Menurunkannya membuat P50/P90 lebih berderau, bukan lebih cepat secara nyata.
MONTE_CARLO_DRAWS=2000


# --- Operasional ------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
# Log keluar sebagai JSON dengan request_id yang merambat dari sisi Go, jadi
# satu permintaan bisa ditelusuri lintas dua layanan dengan satu grep.
LOG_LEVEL=INFO
